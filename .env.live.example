# Credentials for `npm run test:live` (copy to .env.live, which is git-ignored).
# Two mailboxes on the same provider; the test sends mail between them and
# only touches messages whose subject carries a unique run id plus its own folders.
LIVE_SMTP_HOST=smtp.ionos.de
LIVE_SMTP_PORT=587
LIVE_IMAP_HOST=imap.ionos.de
LIVE_IMAP_PORT=993

LIVE_A_USER=first@example.com
LIVE_A_PASS=
LIVE_B_USER=second@example.com
LIVE_B_PASS=
